server {
    listen {{ tailscale_address }}:{{ swag_https_port }} ssl;
    listen {{ ansible_default_ipv4.address }}:{{ swag_https_port }} ssl;
    listen 127.0.0.1:{{ swag_https_port }} ssl;

    server_name {{ zigbee2mqtt_subdomain }}.{{ swag_domain }};
{% for cidr in swag_internal_cidrs %}
    allow {{ cidr }};
{% endfor %}
    deny all;

    include /config/nginx/ssl.conf;

    client_max_body_size 0;

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app zigbee2mqtt;
        set $upstream_port 8080;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
